    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^5.4.0"
  }
